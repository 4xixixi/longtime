{
  "name": "dsh-mcp-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local MCP server and DSH runtime adapter for Longtime",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env bridge.mjs",
    "doctor": "node --env-file-if-exists=.env doctor.mjs",
    "test": "node --test tests/*.test.mjs",
    "probe": "node scripts/probe.mjs",
    "demo": "node scripts/demo-server.mjs",
    "demo:client": "node scripts/demo-client.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.4.0"
  }
}
