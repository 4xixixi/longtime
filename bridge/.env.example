# Copy to .env and replace paths. npm start / npm run doctor load it automatically.
# Use forward slashes on Windows, e.g. D:/projects/example.
DSH_BRIDGE_HOST=127.0.0.1
DSH_BRIDGE_PORT=3420
DSH_BRIDGE_WORKSPACES=/absolute/path/to/target-repository
DSH_BRIDGE_EPOCH_TIMEOUT_MS=45000
# DSH_BRIDGE_INSTALL=/absolute/path/to/node_modules/@deepseek-ai/dsh
# DSH_HOME=/absolute/path/to/private-dsh-home
# Optional compatibility patch for opencode-go session routing:
DSH_BRIDGE_SESSION_ROUTING=0
# Never place provider credentials in this public example.
